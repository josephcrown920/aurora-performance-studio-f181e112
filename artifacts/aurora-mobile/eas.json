{
  "cli": {
    "version": ">= 21.0.2",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "env": {
        "EAS_NO_VCS": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EAS_NO_VCS": "1"
      }
    },
    "production": {
      "node": "22.17.0",
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "auroraperformancestudio.com",
        "EAS_NO_VCS": "1"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "image": "latest"
      }
    }
  }
}
